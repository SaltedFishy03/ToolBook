@using ToolBook.Client.Enums
@model ToolBook.Client.Models.Admin.CreateToolViewModel

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">

    <div class="card shadow border-0 p-4" style="width: 100%; max-width: 400px;">

        <div class="card-body">

            <div class="text-center mb-4">
                <h2>Opret værktøj</h2>
                <p class="text-muted">Opret et nyt værktøj</p>
            </div>

            <form asp-action="CreateTool" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Tool.ToolNumber" class="form-label">
                        Værktøjsnummer
                    </label>

                    <input asp-for="Tool.ToolNumber"
                           class="form-control"
                           placeholder="Værktøjsnummer">

                    <span asp-validation-for="Tool.ToolNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tool.ToolTypeId" class="form-label">
                        Værktøjstype
                    </label>

                    <select asp-for="Tool.ToolTypeId" class="form-select">
                        <option value="">Vælg værktøjstype</option>

                        @foreach (var toolType in Model.ToolTypes)
                        {
                            <option value="@toolType.Id">
                                @toolType.Name
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Tool.ToolTypeId"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Tool.Status" class="form-label">
                        Status
                    </label>

                    <select asp-for="Tool.Status"
                            asp-items="Html.GetEnumSelectList<ToolStatus>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Tool.Status"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 mb-2">
                    Opret
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    Tilbage
                </a>

            </form>
        </div>
    </div>

</div>