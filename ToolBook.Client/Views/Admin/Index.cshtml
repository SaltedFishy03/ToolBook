@model ToolBook.Client.Models.Admin.AdminViewModel

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-4">

    @* Værktøjer *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Værktøjer</h2>

        <a asp-controller="Admin"
           asp-action="CreateTool"
           class="btn btn-primary">
            Opret værktøj
        </a>
    </div>

    <table class="table table-striped align-middle mb-5">
        <thead>
        <tr>
            <th>Værktøjsnummer</th>
            <th>Værktøjstype</th>
            <th>Status</th>
            <th>Handlinger</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var tool in Model.Tools)
        {
            <tr>
                <td>@tool.ToolNumber</td>
                <td>@tool.ToolTypeName</td>
                <td>@tool.Status</td>
                <td>
                    <a asp-controller="Admin"
                       asp-action="EditTool"
                       asp-route-id="@tool.Id"
                       class="btn btn-sm btn-warning">
                        Rediger
                    </a>
                    <form asp-controller="Admin"
                          asp-action="DeleteTool"
                          asp-route-id="@tool.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Er du sikker på, at du vil slette værktøjet?')">
                            Slet
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>


    @* Værktøjstyper *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Værktøjstyper</h2>

        <a asp-controller="Admin"
           asp-action="CreateToolType"
           class="btn btn-primary">
            Opret kategori
        </a>
    </div>

    <table class="table table-striped align-middle mb-5">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Beskrivelse</th>
            <th>Kategori</th>
            <th>Handlinger</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var toolType in Model.ToolTypes)
        {
            <tr>
                <td>@toolType.Name</td>
                <td>@toolType.Description</td>
                <td>@toolType.CategoryName</td>
                <td>
                    <a asp-controller="Admin"
                       asp-action="EditToolType"
                       asp-route-id="@toolType.Id"
                       class="btn btn-sm btn-warning">
                        Rediger
                    </a>
                    <form asp-controller="Admin"
                          asp-action="DeleteToolType"
                          asp-route-id="@toolType.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Er du sikker på, at du vil slette værktøjstypen?')">
                            Slet
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>


    @* Kategorier *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kategorier</h2>

        <a asp-controller="Admin"
           asp-action="CreateCategory"
           class="btn btn-primary">
            Opret kategori
        </a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Beskrivelse</th>
            <th>Handlinger</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>
                    <a asp-controller="Admin"
                       asp-action="EditCategory"
                       asp-route-id="@category.Id"
                       class="btn btn-sm btn-warning">
                        Rediger
                    </a>
                    <form asp-controller="Admin"
                          asp-action="DeleteCategory"
                          asp-route-id="@category.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Er du sikker på, at du vil slette kategorien?')">
                            Slet
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

</div>