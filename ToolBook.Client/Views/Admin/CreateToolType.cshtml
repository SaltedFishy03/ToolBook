@model ToolBook.Client.Models.Admin.CreateToolTypeViewModel

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">

    <div class="card shadow border-0 p-4" style="width: 100%; max-width: 400px;">

        <div class="card-body">

            <div class="text-center mb-4">
                <h2>Opret værktøjstype</h2>
                <p class="text-muted">Opret en værktøjstype til værktøjerne</p>
            </div>

            <form asp-action="CreateToolType" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ToolType.Name" class="form-label">Navn</label>
                    <input asp-for="ToolType.Name"
                           class="form-control"
                           placeholder="Navn på værktøjstypen">
                    <span asp-validation-for="ToolType.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToolType.Description" class="form-label">Beskrivelse</label>
                    <textarea asp-for="ToolType.Description"
                  class="form-control"
                  rows="3"
                  placeholder="Beskrivelse af værktøjstypen"></textarea>
                    <span asp-validation-for="ToolType.Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ToolType.CategoryId" class="form-label">Kategori</label>

                    <select asp-for="ToolType.CategoryId" class="form-select">
                        <option value="">Vælg kategori</option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>

                    <span asp-validation-for="ToolType.CategoryId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 mb-2">
                    Opret
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    Tilbage
                </a>

            </form>
        </div>
    </div>

</div>