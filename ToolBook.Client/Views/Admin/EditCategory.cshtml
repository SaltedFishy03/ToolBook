@model ToolBook.Client.Models.ToolCategories.UpdateToolCategoryRequest

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">

    <div class="card shadow border-0 p-4" style="width: 100%; max-width: 400px;">
        <div class="card-body">

            <div class="text-center mb-4">
                <h2>Rediger kategori</h2>
                <p class="text-muted">Rediger kategoriens oplysninger</p>
            </div>

            <form asp-action="EditCategory" method="post">

                <input type="hidden" name="id" value="@ViewBag.CategoryId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Navn</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Beskrivelse</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 mb-2">
                    Gem ændringer
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    Tilbage
                </a>

            </form>

        </div>
    </div>

</div>