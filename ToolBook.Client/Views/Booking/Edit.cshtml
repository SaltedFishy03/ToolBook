@model ToolBook.Client.Models.Bookings.EditBookingViewModel

@{
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1>Rediger booking</h1>
        <p class="text-muted">Opdater bookingen nedenfor</p>
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4">

        <form asp-controller="Booking"
              asp-action="Edit"
              method="post">

            <input type="hidden" asp-for="Id" />
            
            @if (Model.StartDate <= DateOnly.FromDateTime(DateTime.Today))
            {
                <input type="hidden" asp-for="ToolId" />
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="ToolId" class="form-label">Værktøj</label>

                    <select asp-for="ToolId" class="form-select">
                        @foreach (var tool in Model.Tools)
                        {
                            <option value="@tool.Id">
                                @tool.ToolTypeName - @tool.ToolNumber
                            </option>
                        }
                    </select>
                </div>
            }

            @if (Model.StartDate <= DateOnly.FromDateTime(DateTime.Today))
            {
                <label class="form-label">Startdato</label>

                <input type="date"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")"
                       class="form-control"
                       disabled />

                <input type="hidden" asp-for="StartDate" />
            }
            else
            {
                <label asp-for="StartDate" class="form-label">Startdato</label>

                <input asp-for="StartDate"
                       type="date"
                       class="form-control"
                       min="@today" />
            }

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">
                    Slutdato
                </label>

                <input asp-for="EndDate"
                       type="date"
                       class="form-control"
                       min="@today" />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-controller="Booking"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Tilbage
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Gem ændringer
                </button>
            </div>

        </form>

    </div>
</div>