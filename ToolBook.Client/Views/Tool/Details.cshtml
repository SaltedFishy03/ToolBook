@model ToolBook.Client.Models.Tools.ToolDetailsViewModel

@{
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>@Model.ToolTypeName</h1>
        <p class="text-muted">Vælg en periode og se tilgængelige værktøjer</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    
    <div class="card shadow-sm border-0 rounded-4 p-4">

        @* Toolfilter *@
        <form asp-controller="Tool" asp-action="Details" method="get">

            @* Beholder ToolTypeId når filteret sendes *@
            <input type="hidden" name="id" value="@Model.ToolTypeId" />

            <div class="row g-3">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">
                        Startdato
                    </label>

                    <input asp-for="StartDate" type="date" class="form-control" min="@today" />
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">
                        Slutdato
                    </label>

                    <input asp-for="EndDate" type="date"class="form-control" min="@today" />
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        Tjek ledighed
                    </button>
                </div>
            </div>
        </form>
    </div>


    @* Fysiske værktøjer *@
    <div class="row g-4 mt-3">

        @foreach (var tool in Model.Tools)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">

                        <h5 class="card-title">
                            Værktøj #@tool.ToolNumber
                        </h5>

                        @* Vis altid eksisterende bookinger *@
                        @if (!tool.Bookings.Any())
                        {
                            <p class="text-muted">
                                Ingen kommende bookinger
                            </p>
                        }
                        else
                        {
                            <p class="mb-2">
                                <strong>Kommende bookinger:</strong>
                            </p>

                            @foreach (var booking in tool.Bookings)
                            {
                                <p class="mb-1">
                                    @booking.StartDate.ToString("dd/MM/yyyy")
                                    -
                                    @booking.EndDate.ToString("dd/MM/yyyy")
                                </p>
                            }
                        }

                        <hr />

                        @* Kun hvis en gyldig periode er valgt *@
                        @if (tool.IsAvailable == true)
                        {
                            <p class="text-success">
                                <strong>Ledig i den valgte periode</strong>
                            </p>

                            <form asp-controller="Booking"
                                  asp-action="Create"
                                  method="post">

                                <input type="hidden" name="ToolId" value="@tool.Id" />
                                <input type="hidden" name="toolTypeId" value="@Model.ToolTypeId" />
                                <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />

                                <button type="submit"
                                        class="btn btn-primary"
                                        onclick="return confirm('Er du sikker på, at du vil booke dette værktøj?')">
                                    Book
                                </button>
                            </form>
                        }
                        else if (tool.IsAvailable == false)
                        {
                            <p class="text-danger">
                                <strong>Ikke ledig i den valgte periode</strong>
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                Vælg en gyldig periode for at kunne booke
                            </p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>